# Bien moi truong cho frontend tren Netlify (Site configuration > Environment variables).
NEXT_PUBLIC_API_BASE=https://nhatanh-backend-production.up.railway.app/api/v1
NEXT_PUBLIC_SITE_URL=https://nhatanh.netlify.app
# Dat =true trong luc chua co anh that de Google khong index. Bo di khi san sang.
NEXT_PUBLIC_NOINDEX=true
