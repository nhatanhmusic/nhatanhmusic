# Bien moi truong cho backend khi chay tren may chu (profile `server`).
# Copy noi dung nay vao phan Variables cua Railway/Render — KHONG commit file .env that.

# Neon: lay tu Dashboard > Connection string, chon "JDBC"
DB_URL=jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/nhatanh?sslmode=require
DB_USER=nhatanh_owner
DB_PASSWORD=

# Chuoi ngau nhien >= 32 ky tu. Sinh bang: openssl rand -base64 48
JWT_SECRET=

# Tai khoan quan tri dau tien. Vao /admin doi mat khau ngay sau lan dang nhap dau.
ADMIN_EMAIL=chu-shop@nhatanh.vn
ADMIN_PASSWORD=
ADMIN_NAME=Nhật Anh

# Domain cua frontend, de trinh duyet goi duoc API. Nhieu domain thi cach nhau dau phay.
CORS_ORIGINS=https://nhatanh.vercel.app

# Anh. Chua co R2 thi tro ve route placeholder cua frontend:
MEDIA_PUBLIC_BASE_URL=https://nhatanh.vercel.app/media
# Co R2 roi thi dien 4 dong nay va doi MEDIA_PUBLIC_BASE_URL sang domain cong khai cua bucket:
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=nhatanh-media
